# GitHub Personal Access Token (PAT)
# 'repo' yetkisi vermeniz private ve public tüm repolarınızı okuyup güncellemek için yeterlidir.
GITHUB_TOKEN=

# GitHub Kullanıcı Adı (Opsiyonel)
GITHUB_USERNAME=

# Port (Varsayılan 3000)
PORT=3000
HOST=127.0.0.1

# Ağ erişiminde zorunlu; CLI için aynı değeri ortam değişkeni olarak verin.
REPOPILOT_API_TOKEN=
# Webhook etkinleştirmek için GitHub'daki secret ile aynı değeri kullanın.
GITHUB_WEBHOOK_SECRET=
# Varsayılan saat dilimi
REPOPILOT_TIMEZONE=Europe/Istanbul
